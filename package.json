{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "npm install --legacy-peer-deps && npm run build:client && npm run build:server",
    "build:client": "npx vite build --outDir dist/client",
    "build:server": "npx vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.294.0",
    "mongoose": "^8.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "sirv": "^2.0.4",
    "vite": "^4.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": "^18.0.0"
  }
}